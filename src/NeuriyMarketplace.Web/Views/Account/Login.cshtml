@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="panel panel--narrow">
    <h1 class="page-title">Sign in</h1>
    <p class="lede">Use your email or username to access uploads and admin tools.</p>
    <form asp-action="Login" method="post" class="upload-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label class="field"><span>Email or username</span><input asp-for="Login" /></label>
        <label class="field"><span>Password</span><input asp-for="Password" /></label>
        <div class="form-actions">
            <button type="submit" class="button button--primary">Sign in</button>
            <a class="button button--ghost" asp-action="Register">Register</a>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
