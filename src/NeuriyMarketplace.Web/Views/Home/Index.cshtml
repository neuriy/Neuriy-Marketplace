@model HomeViewModel
@{
    ViewData["Title"] = "Store";
    ViewBag.Query = Model.Query;
    ViewBag.Category = Model.Category;
    ViewBag.Sort = Model.Sort;
    var apiBase = (string?)ViewBag.ApiBaseUrl ?? "http://127.0.0.1:8000";
    var signedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString("AccessToken"));
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="banner banner--warn">@ViewBag.ErrorMessage</div>
}

<section class="store-hero">
    <div class="store-hero__copy">
        <p class="store-hero__brand">Neuriy Marketplace</p>
        <h1 class="store-hero__title">Apps and tools for Neuriy AI</h1>
        <p class="store-hero__lede">Browse featured assistants, publish your own packages, and open installs from Neuriy Chat.</p>
        <div class="store-hero__actions">
            <a class="button button--primary" href="#featured">Explore featured</a>
            @if (signedIn)
            {
                <a class="button button--ghost" asp-controller="Apps" asp-action="Upload">Upload your app</a>
            }
            else
            {
                <a class="button button--ghost" asp-controller="Account" asp-action="Register">Create account</a>
            }
            <a class="button button--ghost" asp-controller="Pages" asp-action="Sdk">Open in Neuriy Chat</a>
        </div>
    </div>
    <div class="store-hero__visual" aria-hidden="true">
        <div class="store-hero__orbit">
            <img src="~/images/neuriy-logo.svg" alt="" width="120" height="120" />
        </div>
    </div>
</section>

<section class="categories-bar">
    <form method="get" asp-controller="Home" asp-action="Index" class="categories-form">
        <input type="hidden" name="q" value="@Model.Query" />
        <input type="hidden" name="sort" value="@Model.Sort" />
        <label class="categories-trigger">
            <span class="categories-trigger__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="3" width="7" height="7" stroke="currentColor" stroke-width="1.8"/>
                    <rect x="14" y="3" width="7" height="7" stroke="currentColor" stroke-width="1.8"/>
                    <rect x="3" y="14" width="7" height="7" stroke="currentColor" stroke-width="1.8"/>
                    <rect x="14" y="14" width="7" height="7" stroke="currentColor" stroke-width="1.8"/>
                </svg>
            </span>
            <select name="category" class="categories-select" onchange="this.form.submit()" aria-label="All Categories">
                @foreach (var category in Model.Categories)
                {
                    if (string.Equals(category, Model.Category, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@category" selected>@category</option>
                    }
                    else
                    {
                        <option value="@category">@category</option>
                    }
                }
            </select>
            <span class="categories-trigger__chevron" aria-hidden="true">▾</span>
        </label>
    </form>
</section>

<section class="panel" id="featured">
    <div class="panel__header">
        <h2 class="panel__title">Featured Apps</h2>
        <a class="panel__link" asp-controller="Home" asp-action="Index" asp-route-sort="popular">View All »</a>
    </div>
    <div class="app-row">
        @if (Model.FeaturedApps.Count == 0)
        {
            <p class="empty">No featured apps yet.</p>
        }
        else
        {
            @foreach (var app in Model.FeaturedApps.Take(7))
            {
                ViewBag.ApiBaseUrl = apiBase;
                <partial name="_AppTile" model="app" />
            }
        }
    </div>
</section>

<section class="panel">
    <div class="panel__header panel__header--tabs">
        <div class="tabs" role="tablist">
            <a class="tab @(Model.Sort == "popular" ? "is-active" : "")"
               role="tab"
               asp-controller="Home"
               asp-action="Index"
               asp-route-q="@Model.Query"
               asp-route-category="@Model.Category"
               asp-route-sort="popular">Popular</a>
            <a class="tab @(Model.Sort == "new" ? "is-active" : "")"
               role="tab"
               asp-controller="Home"
               asp-action="Index"
               asp-route-q="@Model.Query"
               asp-route-category="@Model.Category"
               asp-route-sort="new">New</a>
        </div>
        <a class="panel__link"
           asp-controller="Home"
           asp-action="Index"
           asp-route-q="@Model.Query"
           asp-route-category="@Model.Category"
           asp-route-sort="@Model.Sort">View All »</a>
    </div>
    <div class="app-grid">
        @if (Model.CatalogApps.Count == 0)
        {
            <p class="empty">No apps match your search.</p>
        }
        else
        {
            @foreach (var app in Model.CatalogApps)
            {
                ViewBag.ApiBaseUrl = apiBase;
                <partial name="_AppTile" model="app" />
            }
        }
    </div>
</section>

<section class="panel panel--cta">
    <div class="cta-row">
        <div>
            <h2 class="panel__title">Build for Neuriy Chat</h2>
            <p class="lede">Use the official SDK to search, install, and open marketplace apps from Neuriy Chat conversations.</p>
        </div>
        <a class="button button--primary" asp-controller="Pages" asp-action="Sdk">Get the SDK</a>
    </div>
</section>
