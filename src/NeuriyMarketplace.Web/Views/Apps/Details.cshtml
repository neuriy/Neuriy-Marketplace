@using System.Globalization
@model MarketplaceApp
@{
    ViewData["Title"] = Model.Name;
    var apiBase = (string?)ViewBag.ApiBaseUrl ?? "http://127.0.0.1:8000";
    var icon = string.IsNullOrWhiteSpace(Model.IconUrl)
        ? Url.Content("~/images/neuriy-mark.svg")
        : (Model.IconUrl!.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Model.IconUrl
            : apiBase.TrimEnd('/') + Model.IconUrl);
    var filled = (int)Math.Round(Math.Clamp(Model.Rating, 0, 5));
    var canDownload = string.Equals(Model.Status, "approved", StringComparison.OrdinalIgnoreCase);
}

<section class="panel panel--detail">
    <div class="detail">
        <img class="detail__icon" src="@icon" alt="" width="112" height="112" />
        <div class="detail__body">
            <h1 class="detail__title">@Model.Name</h1>
            <p class="detail__meta">@Model.Developer · @Model.Category · v@(Model.Version)</p>
            <p class="detail__price">@Model.Price</p>
            <p class="status-pill status-pill--@Model.Status.ToLowerInvariant()">Status: @Model.Status</p>
            @if (Model.ModerationScore.HasValue)
            {
                <p class="muted">System AI score: @Model.ModerationScore.Value.ToString("0.0", CultureInfo.InvariantCulture)</p>
            }
            <div class="detail__stars" aria-label="@Model.Rating.ToString("0.0", CultureInfo.InvariantCulture) stars">
                @for (var i = 1; i <= 5; i++)
                {
                    <span class="star @(i <= filled ? "is-filled" : "")">★</span>
                }
                <span class="detail__downloads">@Model.Downloads.ToString("N0") downloads</span>
            </div>
            <div class="detail__actions">
                @if (canDownload)
                {
                    <a class="button button--primary" asp-controller="Apps" asp-action="Download" asp-route-id="@Model.Id">Download for Neuriy AI</a>
                }
                else
                {
                    <span class="button button--ghost" aria-disabled="true">Download unavailable</span>
                }
                <a class="button button--ghost" asp-controller="Home" asp-action="Index">Back to store</a>
            </div>
        </div>
    </div>
    <div class="detail__description">
        <h2>About this app</h2>
        <p>@Model.Description</p>
        @if (!string.IsNullOrWhiteSpace(Model.ModerationNotes))
        {
            <h2>Moderation notes</h2>
            <p class="muted">@Model.ModerationNotes</p>
        }
    </div>
</section>
