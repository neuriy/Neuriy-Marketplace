@{
    ViewData["Title"] = "Developers";
}
<section class="panel panel--narrow content-page">
    <h1 class="page-title">Developer docs</h1>
    <p class="lede">Ship tools that Neuriy Chat users can discover, install, and run.</p>
    <h2>Quick path</h2>
    <ol>
        <li>Create an account and upload a <code>.neuriy</code> package.</li>
        <li>Pass system AI moderation (or ask an administrator to review).</li>
        <li>Integrate the Python SDK so Neuriy Chat can search and open your app.</li>
    </ol>
    <p>
        <a class="button button--primary" asp-controller="Pages" asp-action="Sdk">Neuriy Chat SDK</a>
        <a class="button button--ghost" href="http://127.0.0.1:8000/docs">API docs</a>
    </p>
</section>
