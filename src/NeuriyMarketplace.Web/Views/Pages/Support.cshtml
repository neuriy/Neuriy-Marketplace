@{
    ViewData["Title"] = "Support";
}
<section class="panel panel--narrow content-page">
    <h1 class="page-title">Support</h1>
    <p class="lede">Get help with downloads, uploads, accounts, and Neuriy Chat SDK setup.</p>
    <ul>
        <li><strong>Uploads rejected?</strong> Check moderation notes on the app details page and improve description quality.</li>
        <li><strong>Cannot download?</strong> Only approved apps are downloadable; blacklisted packages are blocked by system AI rules.</li>
        <li><strong>SDK issues?</strong> See the <a asp-controller="Pages" asp-action="Sdk">SDK guide</a> and confirm the API is running on port 8000.</li>
    </ul>
    <p>Contact: <a href="mailto:support@neuriy.local">support@neuriy.local</a></p>
</section>
