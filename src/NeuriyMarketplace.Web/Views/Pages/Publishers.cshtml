@{
    ViewData["Title"] = "Publishers";
}
<section class="panel panel--narrow content-page">
    <h1 class="page-title">Publishers</h1>
    <p class="lede">Publish your app or tool for Neuriy AI users worldwide.</p>
    <ol>
        <li>Register an account.</li>
        <li>Prepare a package (<code>.neuriy</code> or zip) and a short quality description.</li>
        <li>Upload from the store — system AI scores standards automatically.</li>
    </ol>
    <p><a class="button button--primary" asp-controller="Apps" asp-action="Upload">Upload an app</a></p>
</section>
